// Hicri Tarih Dönüştürücü Fonksiyon (Yaklaşık)
fun gregorianToHijri(date: Date): String {
    val cal = Calendar.getInstance()
    cal.time = date
    val day = cal.get(Calendar.DAY_OF_MONTH)
    val month = cal.get(Calendar.MONTH) + 1
    val year = cal.get(Calendar.YEAR)

    // Basit yaklaşık formül (Kütüphanesiz)
    // Bu formül Hicri yılı miladi yıla çevirir, kesin sonuç için kütüphane gerekir.
    val jd = (1461 * (year + 4800 + (month - 14) / 12)) / 4 +
            (367 * (month - 2 - 12 * ((month - 14) / 12))) / 12 -
            (3 * ((year + 4900 + (month - 14) / 12) / 100)) / 4 +
            day - 32075

    val l = jd - 1948440 + 10632
    val n = (l - 1) / 10631
    val l2 = l - 10631 * n + 354
    val j = ((10985 - l2) / 5316) * ((50 * l2) / 17719) + (l2 / 5670) * ((43 * l2) / 15238)
    val l3 = l2 - ((30 - j) / 15) * ((17719 * j) / 50) - (j / 16) * ((15238 * j) / 43) + 29
    val m = (24 * l3) / 709
    val d = l3 - (709 * m) / 24
    val y = 30 * n + j - 30

    val aylar = arrayOf("Muharrem", "Safer", "Rebiülevvel", "Rebiülahir", "Cemaziyelevvel", "Cemaziyelahir", "Recep", "Şaban", "Ramazan", "Şevval", "Zilkade", "Zilhicce")
    val ayAdi = if (m in 1..12) aylar[m - 1] else "Bilinmiyor"

    return "$d $ayAdi $y"
}

class MainActivity : ComponentActivity() {
    private lateinit var sharedPreferences: SharedPreferences
    private val izinIsteLauncher = registerForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) { _ -> }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        sharedPreferences = getSharedPreferences("EzanVaktiPrefs", Context.MODE_PRIVATE)
        izinleriIste()

        setContent {
            EzanVaktiTheme {
                Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
                    AnaEkran()
                }
            }
        }
    }

    private fun izinleriIste() {
        val izinler = mutableListOf<String>()
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) izinler.add(Manifest.permission.POST_NOTIFICATIONS)
        if (izinler.isNotEmpty()) izinIsteLauncher.launch(izinler.toTypedArray())
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            val alarmManager = getSystemService(Context.ALARM_SERVICE) as AlarmManager
            if (!alarmManager.canScheduleExactAlarms()) {
                startActivity(Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM))
            }
        }
    }
}

@Composable
fun AnaEkran() {
    val context = LocalContext.current
    val sharedPreferences = context.getSharedPreferences("EzanVaktiPrefs", Context.MODE_PRIVATE)

    var kalanSaniye by remember { mutableStateOf(0L) }
    var hedefVakitZamani by remember { mutableStateOf(0L) }
    var aktifVakit by remember { mutableStateOf("Yükleniyor...") }
    var vakitListesi by remember { mutableStateOf<Map<String, String>>(emptyMap()) }
    var konumMetni by remember { mutableStateOf("Konum Bekleniyor...") }
    var yukleniyor by remember { mutableStateOf(true) }

    var seciliSehir by remember { mutableStateOf(sharedPreferences.getString("sehir", "Duzce") ?: "Duzce") }
    var seciliUlke by remember { mutableStateOf(sharedPreferences.getString("ulke", "Turkey") ?: "Turkey") }
    var showSehirDialog by remember { mutableStateOf(false) }

    // KERAHAT VAKTİ KONTROLÜ (Öğle ve Akşam için 45 dakika)
    fun kerahatVaktiMi(vakitMap: Map<String, String>): Boolean {
        if (vakitMap.isEmpty()) return false
        val simdi = Calendar.getInstance()
        val suankiDakika = simdi.get(Calendar.HOUR_OF_DAY) * 60 + simdi.get(Calendar.MINUTE)

        fun saatToDakika(saatStr: String): Int {
            val p = saatStr.split(":")
            return p[0].toInt() * 60 + p[1].toInt()
        }

        val gunes = saatToDakika(vakitMap["Güneş"] ?: "07:37")
        val ogle = saatToDakika(vakitMap["Öğle"] ?: "12:45")
        val aksam = saatToDakika(vakitMap["Akşam"] ?: "17:43")

        if (suankiDakika >= gunes && suankiDakika <= gunes + 45) return true
        if (suankiDakika >= ogle - 45 && suankiDakika < ogle) return true
        if (suankiDakika >= aksam - 45 && suankiDakika < aksam) return true

        return false
    }

    val ulkeSehirler = mapOf(
        "Turkey" to listOf("Adana", "Ankara", "Antalya", "Bursa", "Diyarbakir", "Duzce", "Erzurum", "Eskisehir", "Gaziantep", "Istanbul", "Izmir", "Kayseri", "Kocaeli", "Konya", "Malatya", "Manisa", "Mersin", "Samsun", "Sanliurfa", "Trabzon", "Van"),
        "Germany" to listOf("Berlin", "Hamburg", "Munich", "Cologne", "Frankfurt", "Stuttgart", "Dusseldorf", "Dortmund", "Essen", "Leipzig"),
        "USA" to listOf("New York", "Los Angeles", "Chicago", "Houston", "Phoenix", "Philadelphia", "San Antonio", "San Diego", "Dallas", "San Jose"),
        "England" to listOf("London", "Birmingham", "Manchester", "Liverpool", "Leeds", "Sheffield", "Bristol", "Newcastle", "Nottingham", "Leicester"),
        "France" to listOf("Paris", "Marseille", "Lyon", "Toulouse", "Nice", "Nantes", "Strasbourg", "Montpellier", "Bordeaux", "Lille"),
        "Netherlands" to listOf("Amsterdam", "Rotterdam", "The Hague", "Utrecht", "Eindhoven", "Tilburg", "Groningen", "Almere", "Breda", "Nijmegen"),
        "Belgium" to listOf("Brussels", "Antwerp", "Ghent", "Charleroi", "Liege", "Bruges", "Namur", "Leuven", "Mons", "Aalst"),
        "Austria" to listOf("Vienna", "Graz", "Linz", "Salzburg", "Innsbruck", "Klagenfurt", "Villach", "Wels", "Sankt Polten", "Dornbirn"),
        "Switzerland" to listOf("Zurich", "Geneva", "Basel", "Lausanne", "Bern", "Winterthur", "Lucerne", "St. Gallen", "Lugano", "Biel"),
        "Azerbaijan" to listOf("Baku", "Ganja", "Sumqayit", "Lankaran", "Mingachevir", "Nakhchivan", "Shirvan", "Shaki", "Yevlakh", "Khirdalan")
    )

    suspend fun vakitleriCek(sehir: String, ulke: String): Map<String, String>? {
        return try {
            // 1. Önce Türkiye'nin ID'sini bulalım (genelde 2'dir ama garanti olsun)
            // 2. Sonra Düzce'nin ID'sini bulalım
            // 3. Sonra Düzce merkez ilçesinin ID'sini bulalım

            // Test için direkt Düzce'yi arayalım
            val searchUrl = URL("https://ezanvakti.imsakiyem.com/api/locations/search/states?q=Duzce")
            val connection = searchUrl.openConnection() as HttpURLConnection
            connection.connectTimeout = 5000
            val response = connection.inputStream.bufferedReader().readText()

            // Gelen cevabı log'a yazdıralım
            android.util.Log.d("EZAN_TEST", "Düzce Arama Sonucu: $response")

            // Şimdilik boş dön, biz sadece log'a bakacağız
            null
        } catch (e: Exception) {
            android.util.Log.e("EZAN_TEST", "Hata: ${e.message}")
            null
        }
    }

    fun siralaVeHedefBul(vakitMap: Map<String, String>) {
        val simdi = Calendar.getInstance()
        val suankiZaman = simdi.timeInMillis
        val vakitZamanlari = mutableListOf<Pair<String, Long>>()

        vakitMap.forEach { (isim, saatStr) ->
            val parcalar = saatStr.split(":")
            val vakitCal = Calendar.getInstance().apply {
                set(Calendar.HOUR_OF_DAY, parcalar[0].toInt())
                set(Calendar.MINUTE, parcalar[1].toInt())
                set(Calendar.SECOND, 0)
                set(Calendar.MILLISECOND, 0)
            }
            vakitZamanlari.add(Pair(isim, vakitCal.timeInMillis))
        }
        vakitZamanlari.sortBy { it.second }
        var hedefVakit = vakitZamanlari.find { it.second > suankiZaman }

        if (hedefVakit != null) {
            aktifVakit = hedefVakit.first
            hedefVakitZamani = hedefVakit.second
        } else {
            aktifVakit = "İmsak"
            val imsakStr = vakitMap["İmsak"]!!
            val p = imsakStr.split(":")
            val ertesiGun = Calendar.getInstance().apply {
                add(Calendar.DAY_OF_YEAR, 1)
                set(Calendar.HOUR_OF_DAY, p[0].toInt())
                set(Calendar.MINUTE, p[1].toInt())
                set(Calendar.SECOND, 0)
                set(Calendar.MILLISECOND, 0)
            }
            hedefVakitZamani = ertesiGun.timeInMillis
        }
    }

    fun tumVakitlerIcinAlarmKur(vakitMap: Map<String, String>) {
        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        val simdi = Calendar.getInstance()

        vakitMap.forEach { (vakitAdi, saatStr) ->
            if (vakitAdi == "Güneş") return@forEach

            val parcalar = saatStr.split(":")
            val vakitCal = Calendar.getInstance().apply {
                set(Calendar.HOUR_OF_DAY, parcalar[0].toInt())
                set(Calendar.MINUTE, parcalar[1].toInt())
                set(Calendar.SECOND, 0)
                set(Calendar.MILLISECOND, 0)
            }

            if (vakitCal.timeInMillis < simdi.timeInMillis) {
                vakitCal.add(Calendar.DAY_OF_YEAR, 1)
            }

            val vakitAktif = sharedPreferences.getBoolean("${vakitAdi}_aktif", true)
            if (!vakitAktif) return@forEach

            val dakikaOnce = sharedPreferences.getInt("${vakitAdi}_dakika", 10)
            val secilenSes = sharedPreferences.getString("${vakitAdi}_ses", "uyari_1") ?: "uyari_1"

            val alarmZamaniOnce = vakitCal.timeInMillis - (dakikaOnce * 60 * 1000)
            if (alarmZamaniOnce > System.currentTimeMillis()) {
                val intentOnce = Intent(context, EzanAlarmReceiver::class.java).apply {
                    putExtra("vakit", "$vakitAdi Ezanına $dakikaOnce Dk Kaldı")
                    putExtra("ses", secilenSes)
                }
                val pendingIntentOnce = PendingIntent.getBroadcast(
                    context, ("once_$vakitAdi").hashCode(), intentOnce,
                    PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                )
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                    if (alarmManager.canScheduleExactAlarms()) alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, alarmZamaniOnce, pendingIntentOnce)
                    else alarmManager.setWindow(AlarmManager.RTC_WAKEUP, alarmZamaniOnce, 10_000, pendingIntentOnce)
                } else {
                    alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, alarmZamaniOnce, pendingIntentOnce)
                }
            }

            if (vakitCal.timeInMillis > System.currentTimeMillis()) {
                val intentTam = Intent(context, EzanAlarmReceiver::class.java).apply {
                    putExtra("vakit", "$vakitAdi Vakti Girdi")
                    putExtra("ses", secilenSes)
                }
                val pendingIntentTam = PendingIntent.getBroadcast(
                    context, ("tam_$vakitAdi").hashCode(), intentTam,
                    PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                )
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                    if (alarmManager.canScheduleExactAlarms()) alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, vakitCal.timeInMillis, pendingIntentTam)
                    else alarmManager.setWindow(AlarmManager.RTC_WAKEUP, vakitCal.timeInMillis, 10_000, pendingIntentTam)
                } else {
                    alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, vakitCal.timeInMillis, pendingIntentTam)
                }
            }
        }
    }

    LaunchedEffect(seciliSehir, seciliUlke) {
        yukleniyor = true

        val kayitliVakitler = sharedPreferences.getString("vakitler", null)
        if (kayitliVakitler != null) {
            try {
                val json = JSONObject(kayitliVakitler)
                val map = mutableMapOf<String, String>()
                map["İmsak"] = json.getString("İmsak")
                map["Güneş"] = json.getString("Güneş")
                map["Öğle"] = json.getString("Öğle")
                map["İkindi"] = json.getString("İkindi")
                map["Akşam"] = json.getString("Akşam")
                map["Yatsı"] = json.getString("Yatsı")
                vakitListesi = map
                siralaVeHedefBul(map)
                tumVakitlerIcinAlarmKur(map)
                yukleniyor = false
            } catch (e: Exception) {}
        }

        konumMetni = "$seciliSehir, $seciliUlke"
        val yeniVakitler = withContext(Dispatchers.IO) { vakitleriCek(seciliSehir, seciliUlke) }

        if (yeniVakitler != null) {
            val json = JSONObject()
            yeniVakitler.forEach { (k, v) -> json.put(k, v) }
            sharedPreferences.edit().putString("vakitler", json.toString()).apply()

            vakitListesi = yeniVakitler
            siralaVeHedefBul(yeniVakitler)
            tumVakitlerIcinAlarmKur(yeniVakitler)
            yukleniyor = false
        } else {
            if (kayitliVakitler == null) {
                konumMetni = "İnternet Yok (Varsayılan)"
                vakitListesi = mapOf("İmsak" to "06:09", "Güneş" to "07:37", "Öğle" to "12:45", "İkindi" to "15:19", "Akşam" to "17:43", "Yatsı" to "19:06")
                siralaVeHedefBul(vakitListesi)
                tumVakitlerIcinAlarmKur(vakitListesi)
                yukleniyor = false
            }
        }
    }

    LaunchedEffect(hedefVakitZamani) {
        while (true) {
            if (hedefVakitZamani > 0) {
                val kalan = hedefVakitZamani - System.currentTimeMillis()
                if (kalan > 0) {
                    kalanSaniye = kalan / 1000
                } else {
                    if (vakitListesi.isNotEmpty()) {
                        siralaVeHedefBul(vakitListesi)
                    } else {
                        kalanSaniye = 0
                    }
                }
            }
            delay(1000)
        }
    }

    Box(
        modifier = Modifier.fillMaxSize().background(Brush.verticalGradient(colors = listOf(Color(0xFF061626), Color(0xFF0A2B35), Color(0xFF07131F))))
    ) {
        Column(modifier = Modifier.fillMaxSize().padding(24.dp).verticalScroll(rememberScrollState()), horizontalAlignment = Alignment.CenterHorizontally) {

            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                Column(modifier = Modifier.clickable { showSehirDialog = true }) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text(konumMetni, fontSize = 18.sp, fontWeight = FontWeight.Bold, color = Color.White)
                        Icon(Icons.Default.ArrowDropDown, contentDescription = "Değiştir", tint = Color.White.copy(alpha = 0.7f))
                    }
                    Text("Şimdi", fontSize = 14.sp, color = Color.White.copy(alpha = 0.5f))
                }

                Box(modifier = Modifier.size(48.dp).background(Color.White.copy(alpha = 0.1f), CircleShape)
                    .clickable(interactionSource = remember { MutableInteractionSource() }, indication = null) {
                        context.startActivity(Intent(context, AyarlarActivity::class.java))
                    }, contentAlignment = Alignment.Center) {
                    Icon(Icons.Default.Settings, contentDescription = "Ayarlar", tint = Color(0xFFFFD780), modifier = Modifier.size(28.dp))
                }
            }

            Spacer(modifier = Modifier.height(24.dp))

            Card(modifier = Modifier.fillMaxWidth().shadow(22.dp, RoundedCornerShape(24.dp)), shape = RoundedCornerShape(24.dp), colors = CardDefaults.cardColors(containerColor = Color.Transparent)) {
                Box(modifier = Modifier.fillMaxWidth().background(Brush.linearGradient(colors = listOf(Color(0xFF174B55), Color(0xFF081A2A))))) {
                    Image(painter = painterResource(id = R.drawable.secde_silueti), contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.matchParentSize().alpha(0.35f))

                    Column(modifier = Modifier.fillMaxWidth().padding(24.dp), horizontalAlignment = Alignment.CenterHorizontally) {
                        if (yukleniyor && vakitListesi.isEmpty()) {
                            CircularProgressIndicator(color = Color(0xFFFFD780))
                        } else {
                            val baslik = if (aktifVakit == "Güneş") "Sabah Namazı" else aktifVakit
                            Text(baslik, fontSize = 26.sp, color = Color.White, fontWeight = FontWeight.Light, letterSpacing = 1.sp)

                            val altYazi = if (aktifVakit == "Güneş") "Güneş doğumuna kalan süre" else "Vaktine kalan süre"
                            Text(altYazi, fontSize = 14.sp, color = Color.White.copy(alpha = 0.6f))

                            Spacer(modifier = Modifier.height(16.dp))

                            val saat = (kalanSaniye / 3600).toString().padStart(2, '0')
                            val dakika = ((kalanSaniye % 3600) / 60).toString().padStart(2, '0')
                            val saniye = (kalanSaniye % 60).toString().padStart(2, '0')
                            Text(text = "$saat:$dakika:$saniye", fontSize = 64.sp, fontWeight = FontWeight.Bold, color = Color(0xFFFFD780))

                            Spacer(modifier = Modifier.height(8.dp))

                            // HİCRİ TARİH EKLENDİ
                            val miladiTarih = SimpleDateFormat("d MMMM yyyy", Locale.getDefault()).format(Date())
                            val hicriTarih = gregorianToHijri(Date())
                            Text("$miladiTarih  |  $hicriTarih", fontSize = 12.sp, color = Color.White.copy(alpha = 0.5f))

                            // KERAHAT VAKTİ UYARISI
                            if (kerahatVaktiMi(vakitListesi)) {
                                Spacer(modifier = Modifier.height(12.dp))
                                Surface(color = Color(0xFFFF6B6B).copy(alpha = 0.2f), shape = RoundedCornerShape(8.dp)) {
                                    Text("Kerahat Vakti", color = Color(0xFFFF6B6B), fontSize = 14.sp, fontWeight = FontWeight.Bold, modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp))
                                }
                            }
                        }
                    }
                }
            }

            Spacer(modifier = Modifier.height(24.dp))

            if (vakitListesi.isNotEmpty()) {
                Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                    vakitListesi.forEach { (isim, saat) ->
                        VakitKutusu(isim, saat, isim == aktifVakit)
                    }
                }
            }

            Spacer(modifier = Modifier.height(32.dp))

            MenuKarti(baslik = "Kıbleyi Bul", aciklama = "Kabe yönünü tespit et", ikon = Icons.Default.Explore, onClick = { context.startActivity(Intent(context, KibleActivity::class.java)) })
            Spacer(modifier = Modifier.height(12.dp))
            MenuKarti(baslik = "Sesli Hikayeler", aciklama = "Dini hikayeleri dinle", ikon = Icons.Default.Headphones, onClick = { context.startActivity(Intent(context, HikayelerActivity::class.java)) })
            Spacer(modifier = Modifier.height(12.dp))
            MenuKarti(baslik = "Dini Günler", aciklama = "Önemli geceler", ikon = Icons.Default.CalendarMonth, onClick = {
                context.startActivity(Intent(context, DiniGunlerActivity::class.java))
            })

            Spacer(modifier = Modifier.height(24.dp))
        }
    }

    if (showSehirDialog) {
        var geciciSehir by remember { mutableStateOf(seciliSehir) }
        var seciliUlkeIngilizce by remember { mutableStateOf(seciliUlke) }
        var elleYaz by remember { mutableStateOf(false) }

        val ulkeler = listOf(
            "Turkey" to "Türkiye", "Germany" to "Almanya", "USA" to "Amerika",
            "England" to "İngiltere", "France" to "Fransa", "Netherlands" to "Hollanda",
            "Belgium" to "Belçika", "Austria" to "Avusturya", "Switzerland" to "İsviçre",
            "Azerbaijan" to "Azerbaycan"
        )

        var ulkeExpanded by remember { mutableStateOf(false) }
        var sehirExpanded by remember { mutableStateOf(false) }

        AlertDialog(
            onDismissRequest = { showSehirDialog = false },
            title = { Text("Şehir ve Ülke Seç") },
            text = {
                Column {
                    Box(modifier = Modifier.fillMaxWidth()) {
                        OutlinedTextField(value = ulkeler.find { it.first == seciliUlkeIngilizce }?.second ?: seciliUlkeIngilizce, onValueChange = { }, readOnly = true, label = { Text("Ülke") },
                            trailingIcon = { IconButton(onClick = { ulkeExpanded = !ulkeExpanded }) { Icon(Icons.Default.ArrowDropDown, contentDescription = "Ülke Seç") } },
                            modifier = Modifier.fillMaxWidth()
                        )
                        DropdownMenu(expanded = ulkeExpanded, onDismissRequest = { ulkeExpanded = false }, modifier = Modifier.fillMaxWidth(0.8f)) {
                            ulkeler.forEach { (ingilizce, turkce) -> DropdownMenuItem(text = { Text(turkce) }, onClick = { seciliUlkeIngilizce = ingilizce; elleYaz = false; ulkeExpanded = false }) }
                        }
                    }

                    Spacer(modifier = Modifier.height(16.dp))

                    if (!elleYaz) {
                        val mevcutSehirler = ulkeSehirler[seciliUlkeIngilizce] ?: emptyList()
                        Box(modifier = Modifier.fillMaxWidth()) {
                            OutlinedTextField(value = geciciSehir, onValueChange = { }, readOnly = true, label = { Text("Şehir Seçin") },
                                trailingIcon = { IconButton(onClick = { sehirExpanded = !sehirExpanded }) { Icon(Icons.Default.ArrowDropDown, contentDescription = "Şehir Seç") } },
                                modifier = Modifier.fillMaxWidth()
                            )
                            DropdownMenu(expanded = sehirExpanded, onDismissRequest = { sehirExpanded = false }, modifier = Modifier.fillMaxWidth(0.8f)) {
                                mevcutSehirler.forEach { sehir -> DropdownMenuItem(text = { Text(sehir) }, onClick = { geciciSehir = sehir; sehirExpanded = false }) }
                                DropdownMenuItem(text = { Text("Kendim Yazacağım", color = Color(0xFFFFD780)) }, onClick = { elleYaz = true; sehirExpanded = false; geciciSehir = "" })
                            }
                        }
                    } else {
                        OutlinedTextField(value = geciciSehir, onValueChange = { geciciSehir = it }, label = { Text("Şehir (İngilizce yazın)") }, modifier = Modifier.fillMaxWidth())
                    }
                }
            },
            confirmButton = {
                TextButton(onClick = {
                    if (geciciSehir.isNotBlank()) {
                        seciliSehir = geciciSehir; seciliUlke = seciliUlkeIngilizce
                        sharedPreferences.edit().putString("sehir", geciciSehir).apply()
                        sharedPreferences.edit().putString("ulke", seciliUlkeIngilizce).apply()
                        showSehirDialog = false
                    }
                }) { Text("Kaydet") }
            },
            dismissButton = { TextButton(onClick = { showSehirDialog = false }) { Text("İptal") } }
        )
    }
}

@Composable
fun VakitKutusu(vakitAdi: String, saat: String, aktifMi: Boolean) {
    val ikon = when (vakitAdi) {
        "İmsak" -> Icons.Default.DarkMode
        "Güneş" -> Icons.Default.WbSunny
        "Öğle" -> Icons.Default.LightMode
        "İkindi" -> Icons.Default.WbTwilight
        "Akşam" -> Icons.Default.WbTwilight
        "Yatsı" -> Icons.Default.NightsStay
        else -> Icons.Default.AccessTime
    }

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Icon(imageVector = ikon, contentDescription = vakitAdi, tint = if (aktifMi) Color(0xFFFFD780) else Color.White.copy(alpha = 0.4f), modifier = Modifier.size(22.dp))
        Spacer(modifier = Modifier.height(6.dp))
        Text(vakitAdi, fontSize = 12.sp, color = if (aktifMi) Color(0xFFFFD780) else Color.White.copy(alpha = 0.6f))
        Text(saat, fontSize = 14.sp, color = if (aktifMi) Color(0xFFFFD780) else Color.White, fontWeight = if (aktifMi) FontWeight.Bold else FontWeight.Normal)
    }
}

@Composable
fun MenuKarti(baslik: String, aciklama: String, ikon: ImageVector, onClick: () -> Unit) {
    Card(modifier = Modifier.fillMaxWidth().shadow(8.dp, RoundedCornerShape(16.dp)).clickable { onClick() }, shape = RoundedCornerShape(16.dp), colors = CardDefaults.cardColors(containerColor = Color(0xFF102B3A))) {
        Row(modifier = Modifier.fillMaxWidth().padding(20.dp), verticalAlignment = Alignment.CenterVertically) {
            Box(modifier = Modifier.size(48.dp).background(Color(0xFFFFD780).copy(alpha = 0.15f), RoundedCornerShape(12.dp)), contentAlignment = Alignment.Center) {
                Icon(imageVector = ikon, contentDescription = baslik, tint = Color(0xFFFFD780))
            }
            Spacer(modifier = Modifier.width(16.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(text = baslik, fontSize = 18.sp, fontWeight = FontWeight.Bold, color = Color.White)
                Text(text = aciklama, fontSize = 14.sp, color = Color.White.copy(alpha = 0.5f))
            }
        }
    }
}
